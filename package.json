{
  "name": "g3x-flugbuch-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "G3X Flugbuch & Motoranalyse — 100% lokale Desktop-App (Rotax 915 iS)",
  "author": "Maximilian Rabl <maximilian.rabl@gmx.at>",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "test": "node backend/selftest.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "at.oefpm.g3xflugbuch",
    "productName": "G3X Flugbuch",
    "artifactName": "G3X-Flugbuch-Setup-${version}.${ext}",
    "asar": false,
    "files": ["electron/**", "backend/**", "core/**", "app/**", "build/icon.ico", "node_modules/**", "package.json"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "G3X-Flight-Log-${version}-${arch}.${ext}"
    },
    "dmg": { "title": "G3X Flight Log ${version}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": ["en_US", "de_DE"],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G3X Flugbuch"
    }
  }
}
